# Server
PORT=4174
DATABASE_FILE=./data/people-map.sqlite

# Optional AI features. Keep this key on the server; never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Open geographic services (no API key required for the demo endpoints).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PHOTON_URL=https://photon.komoot.io
VALHALLA_URL=https://valhalla1.openstreetmap.de
